#!/usr/bin/env bash
# ai-pair-calibrate: drive a TUI through idle/busy and capture
# fingerprint fixtures. Uses `eval` (apps loaded but not started)
# because the calibrator manages its own scoped tmux server and
# does not need the daemon's IPC/PaneSupervisor up.
#
# argv is forwarded via AI_PAIR_ARGV_B64; see ai-pair script for the
# rationale.
set -euo pipefail

script="$0"
while [ -h "$script" ]; do
  link="$(readlink "$script")"
  case "$link" in
    /*) script="$link" ;;
    *) script="$(cd "$(dirname "$script")" && pwd -P)/$link" ;;
  esac
done
release_root="$(cd "$(dirname "$script")/.." && pwd -P)"

if [ "$#" -eq 0 ]; then
  ARGV_B64=""
else
  ARGV_B64="$(printf '%s\0' "$@" | base64 | tr -d '\n')"
fi

exec env AI_PAIR_ARGV_B64="$ARGV_B64" \
  "$release_root/bin/ai_pair" eval 'AiPair.Calibrator.main_from_env()'
