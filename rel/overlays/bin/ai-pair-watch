#!/usr/bin/env bash
# ai-pair-watch: long-running daemon. Foreground process; launchd /
# systemd own the lifecycle. Booting via `start` (not `daemon`) keeps
# stdout/stderr attached so the supervisor can collect logs.
set -euo pipefail

script="$0"
while [ -h "$script" ]; do
  link="$(readlink "$script")"
  case "$link" in
    /*) script="$link" ;;
    *) script="$(cd "$(dirname "$script")" && pwd -P)/$link" ;;
  esac
done
release_root="$(cd "$(dirname "$script")/.." && pwd -P)"

exec "$release_root/bin/ai_pair" start
